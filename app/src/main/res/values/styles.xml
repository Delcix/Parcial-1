<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.ExamenParcial1.InputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="boxStrokeColor">@color/purple_500</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <style name="Widget.ExamenParcial1.InputEdit" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.ExamenParcial1.InputDropdown" parent="Widget.Material3.AutoCompleteTextView.OutlinedBox">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.ExamenParcial1.SmallActionButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">50dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/purple_500</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="Widget.ExamenParcial1.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/purple_500</item>
        <item name="android:textColor">@color/purple_700</item>
    </style>

    <style name="Widget.ExamenParcial1.PrimaryGradientButton" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_purple_gradient</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">30dp</item>
        <item name="android:elevation">5dp</item>
    </style>

</resources>
